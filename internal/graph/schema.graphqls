scalar Int64

scalar Cursor @goModel(model: "starterkit/internal/page.Cursor")

directive @goField(
  forceResolver: Boolean
  name: String
  omittable: Boolean
) on INPUT_FIELD_DEFINITION | FIELD_DEFINITION

directive @goModel(
  model: String
  models: [String!]
  forceGenerate: Boolean
) on OBJECT | INPUT_OBJECT | SCALAR | ENUM | INTERFACE | UNION

type Timestamp @goModel(model: "starterkit/internal/dbtime.Stamp") {
  unix: Int64!
  formatted(layout: String! = "2006-01-02T15:04:05Z07:00"): String!
}

type Query {
  viewer: Viewer!
  admin: AdminQuery!
}

type Mutation {
  signOut: SignOutPayload!
  admin: AdminMutation!
}

type Viewer {
  user: User
  role: ViewerRole! @goField(forceResolver: true)
}

enum ViewerRole {
  ADMIN
  USER
  GUEST
}

type User @goModel(model: "starterkit/internal/db.User") {
  id: Int64!
  email: String!
  name: String!
  createdAt: Timestamp!
}

type SignOutPayload {
  redirectUrl: String!
}

type AdminQuery @goModel(model: "starterkit/internal/model.AdminQuery") {
  users(first: Int64, after: Cursor): UsersConnection!
  user(id: Int64!): AdminUser
  admins(first: Int64, after: Cursor): AdminsConnection!
  auditLog(first: Int64, after: Cursor): AuditLogConnection!
  mcpKeys(first: Int64, after: Cursor): MCPKeysConnection!
  mcpKey(id: Int64!): MCPKey
  build: Build!
}

type Build @goModel(model: "starterkit/internal/buildinfo.Info") {
  commit: String
  builtAt: Timestamp
  commitUrl: String
}

type AdminMutation @goModel(model: "starterkit/internal/model.AdminMutation") {
  banUser(input: BanUserInput!): BanUserOrErrorPayload!
  unbanUser(input: UnbanUserInput!): UnbanUserOrErrorPayload!
  makeAdmin(input: MakeAdminInput!): MakeAdminOrErrorPayload!
  removeAdmin(input: RemoveAdminInput!): RemoveAdminOrErrorPayload!
  createMCPKey(input: CreateMCPKeyInput!): CreateMCPKeyOrErrorPayload!
  revokeMCPKey(input: RevokeMCPKeyInput!): RevokeMCPKeyOrErrorPayload!
  deleteMCPKey(input: DeleteMCPKeyInput!): DeleteMCPKeyOrErrorPayload!
}

type UsersConnection {
  totalCount: Int64! @goField(forceResolver: true)
  nodes: [AdminUser!]!
  pageInfo: PageInfo!
}

type AdminUser @goModel(model: "starterkit/internal/db.DBListUsersRow") {
  id: Int64!
  email: String!
  name: String!
  createdAt: Timestamp!
  lastSignInAt: Timestamp
  isAdmin: Boolean! @goField(forceResolver: true)
  banReason: String!
}

type MCPKeysConnection {
  totalCount: Int64! @goField(forceResolver: true)
  nodes: [MCPKey!]!
  pageInfo: PageInfo!
}

type MCPKey @goModel(model: "starterkit/internal/db.DBListMCPKeysRow") {
  id: Int64!
  name: String!
  ownerEmail: String!
  createdAt: Timestamp!
  lastUsedAt: Timestamp
  revokedAt: Timestamp
}

type AdminsConnection {
  totalCount: Int64! @goField(forceResolver: true)
  nodes: [Admin!]!
  pageInfo: PageInfo!
}

type Admin @goModel(model: "starterkit/internal/db.DBListAdminsRow") {
  userId: Int64!
  email: String!
  name: String!
  createdAt: Timestamp!
}

type AuditLogConnection {
  totalCount: Int64! @goField(forceResolver: true)
  nodes: [AuditLogEntry!]!
  pageInfo: PageInfo!
}

type PageInfo @goModel(model: "starterkit/internal/page.Info") {
  hasNextPage: Boolean!
  endCursor: Cursor
}

type AuditLogEntry @goModel(model: "starterkit/internal/db.AuditLog") {
  id: Int64!
  userId: Int64
  email: String!
  action: String!
  detail: String!
  ip: String!
  createdAt: Timestamp!
}

type ErrorPayload {
  message: String!
  byFields: [FieldMessage!]!
}

type FieldMessage {
  name: String!
  value: String!
}

input BanUserInput {
  userId: Int64!
  reason: String!
}

type BanUserPayload {
  userId: Int64!
}

union BanUserOrErrorPayload = BanUserPayload | ErrorPayload

input UnbanUserInput {
  userId: Int64!
}

type UnbanUserPayload {
  userId: Int64!
}

union UnbanUserOrErrorPayload = UnbanUserPayload | ErrorPayload

input MakeAdminInput {
  userId: Int64!
}

type MakeAdminPayload {
  userId: Int64!
}

union MakeAdminOrErrorPayload = MakeAdminPayload | ErrorPayload

input RemoveAdminInput {
  userId: Int64!
}

type RemoveAdminPayload {
  userId: Int64!
}

union RemoveAdminOrErrorPayload = RemoveAdminPayload | ErrorPayload

input CreateMCPKeyInput {
  name: String!
}

type CreateMCPKeyPayload {
  mcpKeyId: Int64!
  key: String!
}

union CreateMCPKeyOrErrorPayload = CreateMCPKeyPayload | ErrorPayload

input RevokeMCPKeyInput {
  mcpKeyId: Int64!
}

type RevokeMCPKeyPayload {
  mcpKeyId: Int64!
}

union RevokeMCPKeyOrErrorPayload = RevokeMCPKeyPayload | ErrorPayload

input DeleteMCPKeyInput {
  mcpKeyId: Int64!
}

type DeleteMCPKeyPayload {
  mcpKeyId: Int64!
}

union DeleteMCPKeyOrErrorPayload = DeleteMCPKeyPayload | ErrorPayload
