# Copy to .env. One setting for the database, read by dbmate and by the server,
# so `make db-up` and migrate-on-boot cannot drift apart.
DATABASE_URL=sqlite:data.sqlite3

# HTTP listen address of the panel itself.
STARTERKIT_ADDR=127.0.0.1:7301

# URL prefix every route the panel registers lives under; the root serves the
# SPA. The SPA's compiled fallback matches this default - change both together.
STARTERKIT_BASE_PATH=/_system/starterkit

# Public origin the browser sees: the dev stand's Traefik entrypoint, not the
# panel port.
STARTERKIT_PUBLIC_URL=http://panel.sk.localbox

# Dex, through Traefik by name - the same string the browser, oauth2-proxy and
# the panel use, because *.sk.localbox resolves to 127.0.0.81 everywhere
# (README.md, "Names").
STARTERKIT_OIDC_ISSUER=http://dex.sk.localbox/dex
STARTERKIT_OIDC_CLIENT_ID=starterkit

# Email of the first admin. Promoted into `admins` on its first sign-in while
# that table is empty, so a fresh install has a way in.
STARTERKIT_BOOTSTRAP_ADMIN=admin@example.com

STARTERKIT_LOG_LEVEL=info
STARTERKIT_DEV_MODE=true

# CIDRs whose X-Forwarded-For is believed. Traefik runs on host loopback and is
# the only peer the panel ever has. Empty means never believe the header.
STARTERKIT_TRUSTED_PROXIES=127.0.0.1/32,::1/128
