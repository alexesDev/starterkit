$starterkit_users_catalog $starterkit_catalog
	param \user
	menu_title \Users
	page_size 50
	Show_page* $starterkit_users_show
		user_id <= show_user_id* 0
	More $mol_button_minor
		title \Show more
		click? <=> more? null
	menu_body /
		<= Columns $airkit_columns
			titles /
				<= id_column_title @ \ID
				<= email_column_title @ \Email
				<= status_column_title @ \Status
				<= seen_column_title @ \Last sign-in
		<= Menu_links
	menu_link_content* /
		<= User_item* $mol_view
			sub /
				<= Row* $mol_row
					minimal_height 24
					minimal_width 480
					sub <= row_content* /
						<= Id* $starterkit_labeler_id
							value <= row_id_string* \
						<= Email* $starterkit_labeler_name
							title \Email
							value <= row_email* \
						<= Status* $mol_labeler
							title \Status
							content /
								<= Status_pill* $airkit_pill
									tone <= row_tone* \neutral
									title <= row_status* \
						<= Seen* $starterkit_labeler_moment
							title \Last sign-in
							value <= row_last_sign_in* \
